# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API).
#
# ONLY the anon key belongs in a client build. The service_role key bypasses
# RLS entirely and would defeat the secrecy guarantee outright; CI greps dist/
# for it on every PR.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
